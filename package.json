{
  "name": "alevo",
  "version": "0.0.0",
  "private": true,
  "description": "Alevo monorepo — marketing site (getalevo.com) and product app (app.getalevo.com).",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @alevo/web dev",
    "build:web": "pnpm --filter @alevo/web build"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
