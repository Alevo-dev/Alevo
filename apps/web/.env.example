# Product app origin — all Login / Get started / Dashboard CTAs link here.
# Defaults to https://app.getalevo.com when unset.
NEXT_PUBLIC_APP_URL=https://app.getalevo.com

# Cloudflare R2 / CDN origin serving images (e.g. https://assets.getalevo.com).
# Leave unset in local dev to serve placeholders from /public.
NEXT_PUBLIC_ASSETS_URL=
