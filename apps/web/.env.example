# Product app origin — all Login / Get started / Dashboard CTAs link here.
# Defaults to https://app.getalevo.com when unset.
NEXT_PUBLIC_APP_URL=https://app.getalevo.com

# Cloudflare R2 / CDN origin serving images (e.g. https://assets.getalevo.com).
# Leave unset in local dev to serve placeholders from /public.
NEXT_PUBLIC_ASSETS_URL=

# Google Calendar appointment-schedule URL for the "Book a demo" embed on
# /contact. Create one in Google Calendar (Appointment schedules) and paste
# the public link here, e.g.
# https://calendar.google.com/calendar/appointments/schedules/XXXXXXXX
NEXT_PUBLIC_BOOKING_URL=

# Alevo's own chat widget and contact form on this site. Unset: the local app (:3001) in dev, the staging app + workspace once deployed.
# At launch set both (Vercel, production) to the production app and Alevo's production workspace id.
NEXT_PUBLIC_EMBED_APP_URL=
NEXT_PUBLIC_EMBED_ORG_ID=
