# ─── Database (Supabase Postgres, us-east-1) ───────────────────────────────
# Pooled (Supavisor, transaction mode, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true; the client also sets prepare:false.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used ONLY by migrations / drizzle-kit pull.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Clerk (auth + organizations) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Signing secret for the Clerk webhook endpoint (svix). From the Clerk dashboard.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# The app's own PUBLICLY reachable base URL — used as the invite redirect target.
# Dev: your ngrok URL (invites are opened on other devices, so not localhost).
# Prod: https://app.getalevo.com
NEXT_PUBLIC_APP_URL="https://your-static.ngrok-free.app"

# ─── Anthropic (the Qualifier agent) ───────────────────────────────────────
# API key for Claude. The Qualifier runs on Claude Sonnet 5.
# From https://console.anthropic.com/ → API keys.
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Email channel (Resend) ────────────────────────────────────────────────
# The Qualifier emails leads and receives their replies through Resend.
# From https://resend.com → API Keys.
RESEND_API_KEY="re_..."
# Verified SENDING address the Qualifier emails from (org name is the display name).
EMAIL_FROM_ADDRESS="leads@mail.getalevo.com"
# RECEIVING domain (MX → Resend). Replies thread back to reply+<conversationId>@<this>.
# Dev: your auto-generated <id>.resend.app subdomain works. Prod: a custom subdomain.
INBOUND_EMAIL_DOMAIN="inbound.getalevo.com"
# Signing secret (svix) for the Resend "received mail" webhook → /api/webhooks/resend.
RESEND_WEBHOOK_SECRET="whsec_..."

# ─── Knowledge base embeddings (Voyage AI) ─────────────────────────────────
# Embeds KB chunks + Qualifier queries. Anthropic's recommended RAG embeddings.
# From https://dashboard.voyageai.com/ → API Keys. Model: voyage-3.5-lite (1024-dim).
VOYAGE_API_KEY="pa-..."

# ─── SMS channel (Twilio) ──────────────────────────────────────────────────
# Platform Twilio credentials. Each org sets its own Twilio "from" number in
# Settings → Qualifier; outbound sends from it and inbound is routed by it.
# From https://console.twilio.com/ (Account SID + Auth Token).
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""

# ─── Booking calendars (Google Calendar / Microsoft 365 OAuth apps) ────────
# Platform-level OAuth apps; each org connects its own calendar in Workspace →
# Agent → Booking calendar. Redirect URI (register it on the app):
#   ${NEXT_PUBLIC_APP_URL}/api/oauth/google/callback
#   ${NEXT_PUBLIC_APP_URL}/api/oauth/microsoft/callback
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client
# (Web application). Setup steps in DEVELOPMENT.md → "Google Calendar OAuth app".
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Microsoft: entra.microsoft.com → App registrations (multi-tenant). Tenant
# defaults to "common".
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
MICROSOFT_OAUTH_TENANT="common"

# ─── Observability (Sentry) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Auth token for uploading source maps at build time (CI/Vercel only).
SENTRY_AUTH_TOKEN=""

# ─── Cloudflare R2 (S3-compatible object storage) ──────────────────────────
# From the Cloudflare dashboard → R2. The bucket needs a CORS rule allowing PUT
# from the app origin for browser direct-uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ─── Durable workflows (Inngest) ───────────────────────────────────────────
# Set automatically by the Inngest Vercel integration in prod. Local dev uses
# the Inngest dev server and does not need these.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Dev only: shrink the follow-up cadence (+1d/+3d/+3d) to seconds so the full
# nudge → close loop is testable in the Inngest dev server. Leave unset in prod.
CADENCE_FAST=""

# ─── Per-org secret encryption ─────────────────────────────────────────────
# Master key for AES-256-GCM envelope encryption of per-org secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this OUT of the database; losing/rotating it invalidates stored secrets.
SECRETS_MASTER_KEY=""

# ─── Inbound voice (Vapi) ──────────────────────────────────────────────────
# Vapi answers calls on the org's Twilio number and runs the agent. Uses the
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above, and NEXT_PUBLIC_APP_URL for the
# server URL Vapi calls back on (/api/webhooks/vapi).
VAPI_API_KEY=""
# Shared secret Vapi sends back on every server call. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOICE_WEBHOOK_SECRET=""

# ─── PSA write-back (ConnectWise Manage) ───────────────────────────────────
# Alevo's developer client ID (one per integration vendor, from
# developer.connectwise.com → ClientID). Sent on every Manage request. Each
# org adds its own site, company ID, API member and keys in Workspace →
# Integrations → ConnectWise.
CONNECTWISE_CLIENT_ID=

