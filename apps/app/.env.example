# ─── Database (Supabase Postgres, us-east-1) ───────────────────────────────
# Pooled (Supavisor, transaction mode, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true; the client also sets prepare:false.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used ONLY by migrations / drizzle-kit pull.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Clerk (auth + organizations) ──────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Signing secret for the Clerk webhook endpoint (svix). From the Clerk dashboard.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# The app's own PUBLICLY reachable base URL — used as the invite redirect target.
# Dev: your ngrok URL (invites are opened on other devices, so not localhost).
# Prod: https://app.getalevo.com
NEXT_PUBLIC_APP_URL="https://your-static.ngrok-free.app"

# ─── Observability (Sentry) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Auth token for uploading source maps at build time (CI/Vercel only).
SENTRY_AUTH_TOKEN=""

# ─── Durable workflows (Inngest) ───────────────────────────────────────────
# Set automatically by the Inngest Vercel integration in prod. Local dev uses
# the Inngest dev server and does not need these.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Reserved for later phases (do not commit real values) ─────────────────
# Master key for per-org secret envelope encryption (32 bytes, base64).
SECRETS_MASTER_KEY=""
